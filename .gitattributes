# v2.0.0-rc3: force LF line endings for all text files
# This prevents Windows checkout (autocrlf=true) from converting LF to
# CRLF, which some viewers / parsers mis-report as "1 line files".

* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.whl binary
